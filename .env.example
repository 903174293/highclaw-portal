# 生产部署域名模板见仓库根目录 .env.production.example（highclaw.ai），复制为服务器上的 .env.production

# app（须与浏览器地址栏 Origin 一致：协议 + 主机 + 端口，不要多余尾部 /）
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
# 可选：多个可信来源（逗号分隔），解决 www 与非 www、预览域名等导致的 Sign up「Invalid origin」
# AUTH_TRUSTED_ORIGINS=https://example.com,https://www.example.com
NEXT_PUBLIC_APP_NAME = "Your App Name"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
# 服务端 Better Auth base URL，生产建议显式设为与站点一致（默认同 NEXT_PUBLIC_APP_URL）
# AUTH_URL=https://example.com

# 第三方登录：须在 Admin → Settings → Auth 开启并填写 Client ID/Secret，或在此用环境变量打开开关（值为小写 true）
# 否则登录弹窗里不会出现 Google/GitHub 按钮；点击后跳转到 Google/GitHub 授权页，不是站内弹层。
# GOOGLE_AUTH_ENABLED=true
# GITHUB_AUTH_ENABLED=true