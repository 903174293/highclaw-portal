# 生产部署域名模板见仓库根目录 .env.production.example（highclaw.ai），复制为服务器上的 .env.production
#
# 本地目录约定（均在仓库根目录，与 package.json 同级）：
#   .env.local          — 日常 pnpm dev 优先读这里（勿提交）
#   .env.production     — 仅当 NODE_ENV=production 时加载，例如 pnpm build、next start、本地模拟生产
#   打 release 包时：有 .env.production 则打入 tar；没有则用 .env.production.example 生成包内 .env.production

# app（须与浏览器地址栏 Origin 一致：协议 + 主机 + 端口，不要多余尾部 /）
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
# 可选：多个可信来源（逗号分隔），解决 www 与非 www、预览域名等导致的 Sign up「Invalid origin」
# AUTH_TRUSTED_ORIGINS=https://example.com,https://www.example.com
NEXT_PUBLIC_APP_NAME = "Your App Name"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
# 本地用 http + pnpm start（NODE_ENV=production）时 OAuth 可能因 Secure Cookie 失败，可设 false（生产 https 勿用）
# AUTH_COOKIE_SECURE=false
# 服务端 Better Auth base URL（无请求上下文时的回退，如 getSession）。
# /api/auth/* 已按「当前请求的 Host」自动选 Origin，一般可与浏览器不一致时仍能 OAuth；仍建议与 NEXT_PUBLIC_APP_URL 填成同一串。
# 勿混用 localhost 与 127.0.0.1 打开站点；Google 回调 URI 须与当前 Host 一致（各配一条最稳）。
# AUTH_URL=http://localhost:3000

# 第三方登录：须在 Admin → Settings → Auth 开启并填写 Client ID/Secret，或在此用环境变量（值为小写 true）
# 服务端须同时具备 client id + client secret，否则会报 Provider not found；仅开开关未配 Secret 时前端将不再误显按钮。
# GOOGLE_AUTH_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_AUTH_ENABLED=true
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=