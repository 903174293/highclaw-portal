0:{"buildId":"k3g1w3c6HTBmsqYOutAEX","rsc":["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/6e14ac3147af83f2.css","precedence":"next"}]],["$","$L2",null,{"i18n":{"locale":"zh","locales":[{"name":"English","locale":"en"},{"name":"简体中文","locale":"zh"}],"translations":{"search":"搜索内容"}},"search":{"options":{"api":"/api/docs/search"}},"children":["$","$L3",null,{"tree":{"$id":"zh","name":"HighClaw","children":[{"$id":"index.mdx","type":"page","name":"介绍","description":"高性能 AI 智能体基础设施 — 100% Go，单二进制，多渠道网关。","url":"/zh/docs","$ref":{"file":"index.mdx"}},{"$id":"#1","type":"separator","name":"Overview"},{"$id":"comparison.mdx","type":"page","name":"HighClaw vs OpenClaw","description":"Positioning, stack, and operations compared.","url":"/zh/docs/comparison","$ref":{"file":"comparison.mdx"}},{"$id":"quick-start.mdx","type":"page","name":"Quick start","description":"Use pre-built packages from the site, or build from source — then onboard and run the CLI.","url":"/zh/docs/quick-start","$ref":{"file":"quick-start.mdx"}},{"$id":"#4","type":"separator","name":"Guide"},{"$id":"sessions.mdx","type":"page","name":"Session management","description":"Unified sessions for CLI, TUI, and channels.","url":"/zh/docs/sessions","$ref":{"file":"sessions.mdx"}},{"$id":"deployment.mdx","type":"page","name":"Deployment","description":"Build and run on macOS, Ubuntu, CentOS/RHEL, and Windows.","url":"/zh/docs/deployment","$ref":{"file":"deployment.mdx"}},{"$id":"multi-agent.mdx","type":"page","name":"Multi-agent","description":"Registry, routing, sub-agents, and group strategies.","url":"/zh/docs/multi-agent","$ref":{"file":"multi-agent.mdx"}},{"$id":"architecture.mdx","type":"page","name":"Architecture","description":"Trait-based subsystems — swap via config, not code forks.","url":"/zh/docs/architecture","$ref":{"file":"architecture.mdx"}},{"$id":"memory.mdx","type":"page","name":"Memory system","description":"SQLite-native hybrid search, embeddings, and hygiene — no mandatory external vector DB.","url":"/zh/docs/memory","$ref":{"file":"memory.mdx"}},{"$id":"#10","type":"separator","name":"Operations"},{"$id":"security.mdx","type":"page","name":"Security","description":"Multi-layer security model — autonomy levels, workspace sandbox, command risk classification, gateway auth, and channel allowlists.","url":"/zh/docs/security","$ref":{"file":"security.mdx"}},{"type":"folder","name":"Configuration","defaultOpen":true,"children":[{"$id":"config/index.mdx","type":"page","name":"Configuration Overview","description":"All settings live in ~/.highclaw/config.yaml — copy config-default.yaml and customize.","url":"/zh/docs/config","$ref":{"file":"config/index.mdx"}},{"$id":"config/agent.mdx","type":"page","name":"Agent","description":"Core agent settings — model, workspace, streaming mode, runtime limits, and provider keys.","url":"/zh/docs/config/agent","$ref":{"file":"config/agent.mdx"}},{"$id":"config/autonomy.mdx","type":"page","name":"Autonomy","description":"Permission levels, command allowlists, risk classification, and path restrictions.","url":"/zh/docs/config/autonomy","$ref":{"file":"config/autonomy.mdx"}},{"$id":"config/gateway.mdx","type":"page","name":"Gateway","description":"HTTP gateway — port, bind mode, authentication, and Tailscale integration.","url":"/zh/docs/config/gateway","$ref":{"file":"config/gateway.mdx"}},{"$id":"config/channels.mdx","type":"page","name":"Channels","description":"Messaging channel integrations — Telegram, Discord, Slack, WhatsApp, Feishu, WeChat Work, and more.","url":"/zh/docs/config/channels","$ref":{"file":"config/channels.mdx"}},{"$id":"config/reliability.mdx","type":"page","name":"Reliability & Model Routes","description":"Retry strategy, provider fallback chain, and hint-based model routing.","url":"/zh/docs/config/reliability","$ref":{"file":"config/reliability.mdx"}},{"$id":"config/tunnel.mdx","type":"page","name":"Tunnel","description":"Expose your local HighClaw gateway to the internet via Cloudflare, Tailscale, ngrok, or custom tunnels.","url":"/zh/docs/config/tunnel","$ref":{"file":"config/tunnel.mdx"}},{"$id":"config/cron.mdx","type":"page","name":"Cron & Heartbeat","description":"Scheduled tasks, heartbeat system, systemEvent vs agentTurn, and delivery configuration.","url":"/zh/docs/config/cron","$ref":{"file":"config/cron.mdx"}},{"$id":"config/other.mdx","type":"page","name":"Other Settings","description":"Skills, browser, hooks, logging, task audit log, identity, secrets, observability, and auth profiles.","url":"/zh/docs/config/other","$ref":{"file":"config/other.mdx"}}],"$id":"config","$ref":{"metaFile":"config/meta.json"}},{"$id":"identity.mdx","type":"page","name":"Identity","description":"OpenClaw markdown files or AIEOS JSON personas.","url":"/zh/docs/identity","$ref":{"file":"identity.mdx"}},{"$id":"gateway-api.mdx","type":"page","name":"Gateway API","description":"Health, pairing, webhook, and WhatsApp verification endpoints.","url":"/zh/docs/gateway-api","$ref":{"file":"gateway-api.mdx"}},{"$id":"#15","type":"separator","name":"Reference"},{"$id":"commands.mdx","type":"page","name":"Commands (1/2)","description":"Setup, agent, gateway, channels, sessions, memory, models, diagnostics.","url":"/zh/docs/commands","$ref":{"file":"commands.mdx"}},{"$id":"commands-advanced.mdx","type":"page","name":"Commands (2/2)","description":"Browser, cron, hooks, devices, plugins, migration, tasks, agents, subagents, heartbeat, lifecycle.","url":"/zh/docs/commands-advanced","$ref":{"file":"commands-advanced.mdx"}},{"$id":"skills.mdx","type":"page","name":"Skills","description":"SKILL.md-driven skills, open-skills sync, and custom packs.","url":"/zh/docs/skills","$ref":{"file":"skills.mdx"}},{"$id":"development.mdx","type":"page","name":"Development","description":"Build, test, cross-compile, and release from source.","url":"/zh/docs/development","$ref":{"file":"development.mdx"}},{"$id":"community.mdx","type":"page","name":"Commun