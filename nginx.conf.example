# Nginx 配置文件示例
# 将此文件复制到服务器: /etc/nginx/sites-available/highclaw-portal
# 然后创建软链接: sudo ln -s /etc/nginx/sites-available/highclaw-portal /etc/nginx/sites-enabled/
# 最后重启 Nginx: sudo systemctl restart nginx

# 上游 Next.js 服务器
upstream nextjs_backend {
    server 127.0.0.1:3000;
    keepalive 64;
}

# HTTP 服务器块
server {
    listen 80;
    listen [::]:80;
    
    # 替换为你的域名或服务器 IP
    server_name your-domain.com www.your-domain.com;
    
    # 日志文件
    access_log /var/log/nginx/highclaw-portal-access.log;
    error_log /var/log/nginx/highclaw-portal-error.log;
    
    # 可选：重定向 HTTP 到 HTTPS
    # return 301 https://$server_name$request_uri;
    
    # 根路由 - 代理到 Next.js
    location / {
        proxy_pass http://nextjs_backend;
        proxy_http_version 1.1;
        
        # WebSocket 支持
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        # 标准代理头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $server_name;
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # 缓冲设置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }
    
    # Next.js 静态文件 - 长期缓存
    location /_next/static {
        alias /var/www/highclaw-portal/.next/static;
        expires 365d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
    }
    
    # 公共资源 - 中期缓存
    location /public {
        alias /var/www/highclaw-portal/public;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff";
    }
    
    # 图片优化
    location ~* \.(jpg|jpeg|png|gif|ico|webp)$ {
        expires 30d;
        add_header Cache-Control "public";
    }
    
    # 字体文件
    location ~* \.(woff|woff2|ttf|otf|eot)$ {
        expires 365d;
        add_header Cache-Control "public, immutable";
    }
    
    # 禁止访问隐藏文件
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # 健康检查端点（可选）
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

# HTTPS 服务器块（使用 SSL 证书时）
# 取消注释以启用 HTTPS
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     
#     server_name your-domain.com www.your-domain.com;
#     
#     # SSL 证书路径（使用 Certbot 生成）
#     ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
#     
#     # SSL 安全配置
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_ciphers HIGH:!aNULL:!MD5;
#     ssl_prefer_server_ciphers on;
#     ssl_session_cache shared:SSL:10m;
#     ssl_session_timeout 10m;
#     
#     # 其他配置同上...
# }

