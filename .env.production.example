# 生产环境模板（域名 highclaw.ai）
# —— 部署到服务器 ——
#   复制为 /var/www/highclaw-portal/.env.production ，填写下面空项后：
#   pm2 restart highclaw-portal --update-env
# —— 本地 ——
#   cp .env.production.example .env.production
#   （.env.production 已被 git 忽略，勿提交密钥）

# 须与浏览器地址栏一致：协议 + 域名 + 端口，无尾部斜杠
NEXT_PUBLIC_APP_URL=https://highclaw.ai
AUTH_URL=https://highclaw.ai
# Better Auth：同时允许 www，避免 Sign up「Invalid origin」
AUTH_TRUSTED_ORIGINS=https://highclaw.ai,https://www.highclaw.ai

NEXT_PUBLIC_APP_NAME=HighClaw
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_THEME=default
NEXT_PUBLIC_APPEARANCE=dark
NEXT_PUBLIC_DEFAULT_LOCALE=en

# openssl rand -base64 32
AUTH_SECRET=

DATABASE_PROVIDER=postgresql
DATABASE_URL=
DB_SINGLETON_ENABLED=true
DB_MAX_CONNECTIONS=1

# 发信（后台配置或此处，按你项目实际二选一）
# RESEND_API_KEY=
# 其余见 .env.example
