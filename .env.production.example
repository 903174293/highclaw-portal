# 生产环境模板（域名 highclaw.ai）
# —— 部署到服务器 ——
#   复制为 /var/www/highclaw-portal/.env.production ，填写下面空项后：
#   pm2 restart highclaw-portal --update-env
# —— 本地 ——
#   cp .env.production.example .env.production
#   （.env.production 已被 git 忽略，勿提交密钥）

# 须与浏览器地址栏一致：协议 + 域名 + 端口，无尾部斜杠
NEXT_PUBLIC_APP_URL=https://highclaw.ai
AUTH_URL=https://highclaw.ai
# Better Auth：同时允许 www，避免 Sign up「Invalid origin」
AUTH_TRUSTED_ORIGINS=https://highclaw.ai,https://www.highclaw.ai

NEXT_PUBLIC_APP_NAME=HighClaw
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_THEME=default
NEXT_PUBLIC_APPEARANCE=dark
NEXT_PUBLIC_DEFAULT_LOCALE=en

# openssl rand -base64 32
AUTH_SECRET=

DATABASE_PROVIDER=postgresql
DATABASE_URL=
DB_SINGLETON_ENABLED=true
DB_MAX_CONNECTIONS=1

# 发信（后台配置或此处，按你项目实际二选一）
# RESEND_API_KEY=
# 其余见 .env.example

# --- 第三方登录（登录弹窗是否出现 Google/GitHub 由这里或数据库 config 表决定）---
# 打包部署不会带上 .env.production：须在服务器应用目录（与 server.js 同级）手动创建 .env.production。
# 也可只在 Admin → Settings → Auth 开启并填写 Client ID/Secret（写入数据库），不必重复写环境变量。
#
# 生产回调 URL（须在 Google / GitHub 开发者控制台填写，与 NEXT_PUBLIC_APP_URL 一致）：
#   https://highclaw.ai/api/auth/callback/google
#   https://highclaw.ai/api/auth/callback/github
#
GOOGLE_AUTH_ENABLED=true
GITHUB_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 未配齐 Client 前可改为 false，避免出现点不动的社交按钮
